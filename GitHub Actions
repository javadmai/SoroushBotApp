name: Build Flutter APK

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      
      - name: Setup Flutter (32-bit compatible)
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.10.6' # نسخه سازگار با گوشی‌های 32 بیتی
          channel: 'stable'
          
      - name: Generate Android folder
        run: flutter create . --platforms android # این خط پوشه اندروید را می‌سازد
        
      - name: Install dependencies
        run: flutter pub get
        
      - name: Build APK
        run: flutter build apk --release
        
      - name: Upload APK
        uses: actions/upload-artifact@v3
        with:
          name: app-release
          path: build/app/outputs/flutter-apk/app-release.apk